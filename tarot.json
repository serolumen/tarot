    "愚人释义": [
      "（风）占星属天王星，对应十一宫水瓶座，象征自由、革命、反叛与改革、社群与理想主义。新开始、冒险、天真自由、发明与创新精神、冲动的恋情、大胆、潜力、我行我素。在身体上，对应小腿、脚踝与循环系统。逆位时，愚人更加漂泊不定、冒失鲁莽、翘课缺席，或是太在意别人的看法、错失良机。"
    ],
    "魔术师释义": [
      "（风）占星属水星，对应三宫双子或六宫处女座，象征讯息与沟通、初等教育、短途旅行。主动、行动力、万事俱备、创造力、技能、新计划。在身体上，对应神经（大脑）和呼吸系统。逆位时，可能表示欺瞒诈骗、缺乏行动力和交际手腕、失控的局面。"
    ],
    "女祭司释义": [
      "（水）占星属月亮，对应四宫巨蟹座，象征深藏的人格、记忆、情绪、母亲、寻求滋养和安全感。静默、直觉、神秘学、含蓄内敛、倾听内心、单恋、暗恋或独身。在身体上，对应乳房、胃、卵巢和子宫。逆位时，可能表示相反的热情或情绪化、逃避现实、目光短浅或自命不凡。"
    ],
    "女皇释义": [
      "（土/风）占星属金星，对应二宫金牛和七宫天秤座，象征施慧者、美和艺术、享乐和消费。丰收、生产、创造、母性、婚姻或具有吸引力的女性、热情主动。在身体上，对应喉咙（甜言蜜语与情歌），也暗示血糖或怀孕。逆位时，可能表示感情表达的阻碍或失去理智，或是回到女祭司的冷静。"
    ],
    "皇帝释义": [
      "（火）占星属白羊座，对应一宫和火星，象征领导力与创始性、自信、顽固、第一印象、采取行动。权威、理性、秩序、控制欲、主导权、父亲或权威人士。在身体上，对应头部。逆位时，表示不成熟、缺乏责任感，或是滥用权力、控制欲过强。"
    ],
    "教皇释义": [
      "（土）占星属金牛座，对应二宫和金星，象征稳定性、社会习俗、固执、追求物质享受、意志坚定、古老价值观与信仰、金钱。传统、信仰、教导、责任感、理性判断、正统教育、专业人士、宗教。在身体上，对应颈部和喉咙。逆位时，可能表示打破常规。"
    ],
    "恋人释义": [
      "（风）占星属双子座，对应三宫和水星，象征沟通、好奇心、思想和经验的歧异、爱情或精神友谊、手足关系、短途旅行、说话、书写、身体语言。重大抉择、爱情、合作、人际关系。在身体上，对应肺部。逆位时，可能表示分离、三角关系、合作失败、错误的抉择。"
    ],
    "战车释义": [
      "（水）占星属巨蟹座，对应四宫和月亮，象征母性、家庭、防备心、占有欲、敏感、有实用目的的冒险。决心、意志力、胜利、交通工具、改变、竞争、坚持。在身体上，对应乳房与胃部。逆位时，可能表示冲突与阻碍、失控或意外状况。"
    ],
    "力量释义": [
      "（火）占星属狮子座，对应五宫和太阳，象征勇气、自律、决心、英勇、大胆、意志力、骄傲、夸耀、慷慨、戏剧性、乐观正直、表演者。勇气、以柔克刚、内在掌控、耐心。在身体上，对应心脏和脊椎。逆位时，表示软弱无力，宜回到战车的意志力。"
    ],
    "隐者释义": [
      "（土）占星属处女座，对应六宫和水星，象征自律、勤恳、尽责、奉献、孤独、挑剔、哲学、内省与沉思。智慧、探索、谨慎、指引、有智慧的前辈、长者、单身。在身体上，对应神经和消化系统。逆位时，可能表示逃避、愤世嫉俗、我行我素或是粗心大意。"
    ],
    "命运之轮释义": [
      "（火）占星属木星，对应九宫射手座，象征高等教育、运气与机会、长途旅行、成长、过去的回忆、对未来的憧憬。变化、机遇、风水轮流转、能量与物质的循环。在身体上，对应臀部与大腿。逆位时，表示无法把握机会、报应或没有进展、不宜投机。"
    ],
    "正义释义": [
      "（风）占星属天秤座，对应七宫和金星，象征平衡、镇定、优雅、折中妥协、优柔寡断、社交、人道主义理想、艺术。公正、权衡、责任、法律、裁决。在身体上，对应臀部、下背部、肾脏。逆位时，可能表示逃避责任、不公的对待、骗子。"
    ],
    "倒吊人释义": [
      "（水）占星属海王星，对应十二宫双鱼座，象征幻觉、想象力、艺术、理想主义、逃避现实、潜意识。牺牲、新视角、等待、医院、监狱、顺应无为、以退为进。在身体上，对应神经机能。逆位时，可能表示受苦的结束或不愿放手、受社会眼光制约。"
    ],
    "死神释义": [
      "（水）占星属天蝎座，对应火星和冥王星，象征生命的深层秘密、对来世的领悟、转化、改变与重生。旧阶段的结束。在身体上，对应生殖器官。逆位时，可能表示恐惧改变、不愿放手。"
    ],
    "节制释义": [
      "（火）占星属射手座，对应九宫和木星，象征长途旅行、高等教育、哲学、热心独立、不受拘束、乐观。平衡、调和、自律、教学、沟通。在身体上，对应臀部和大腿。逆位时，表示不能妥协、情绪化或过度（如饮酒）。"
    ],
    "恶魔释义": [
      "（土）占星属摩羯座，对应十宫和土星，象征商业、职业、世俗成功与社会地位、表象的追求、物质世界、酗酒、性爱、纵欲。欲望、束缚、沉溺。在身体上，对应膝盖、胫部、脚踝。逆位时，可能表示思想开放、摆脱束缚、不正当方式，不宜求取功名。"
    ],
    "高塔释义": [
      "（火）占星属火星，对应一宫白羊座，象征能源与力量的快速传递或突然爆发、发烧、创伤、疼痛、手术。意外、崩塌、剧变、觉醒、分裂、解体、启蒙与解放（改革）。在身体上，对应血液、男性性器。逆位时不如正位剧烈，可能是当事人将自己囚禁在塔中。"
    ],
    "星星释义": [
      "（风）占星属水瓶座，对应十一宫和天王星，象征社会意识、前瞻性思考、利他主义、神话、秘密、愿望和梦想、方向、公共事业、科技。毁灭之后回归本真；希望、灵感、疗愈、和平、疗愈、信心；失窃。在身体上，对应胫部、脚踝。逆位时，可能表示自大或失去信心。"
    ],
    "月亮释义": [
      "（水）占星属双鱼座，对应十二星和海王星，象征变化不定、敏感、无私、神秘事物、万物不断改变的本质、生命的循环。幻觉、不安、潜意识、恐惧。在身体上，对应足部。逆位时，可能表示隐藏的事物逐渐浮现。"
    ],
    "太阳释义": [
      "（火）占星属太阳，对应狮子座，象征创造力、娱乐。光明、活力、成功、天真、团体。在身体上，对应心脏和脊椎。逆位时，正位的程度稍弱，或表示成功但不满足、阴影中的事物。"
    ],
    "审判释义": [
      "（火）占星属冥王星，对应八宫天蝎座，象征死亡、毁灭、复活、接受测试与挑战、性、死亡、继承。召唤、觉醒、重生、因果、重要选择。逆位时，表示生命转变或自食恶果。"
    ],
    "世界释义": [
      "（土）占星属土星，对应十宫摩羯座，象征结构、界限、限制与约束（秩序井然）、脚踏实地、看清现实、注定的结束、纪律、事业成功。圆满、完成、和谐、旅行。在身体上，对应骨头和皮肤。逆位时，成功的程度减弱，宜接受新阶段。"
    ],
    
    "权杖首牌释义": [
      "（火）新行动、新机会、新生命。大胆去做。"
    ],
    "权杖二释义": [
      "（火）火星在白羊座。新的生意或事业、创造、思考、决断、计划、决策。"
    ],
    "权杖三释义": [
      "（火）太阳在白羊座。远见、合作、进展、创造性驱动力、力量稳健、远距离恋爱、出国、海外。"
    ],
    "权杖四释义": [
      "（火）金星在白羊座。庆祝、稳定、合作、婚姻、伙伴。"
    ],
    "权杖五释义": [
      "（火）土星在狮子座。模拟的战斗、努力奋斗、冲突、不同的意见、模仿；逆位时，竞争不再公平。"
    ],
    "权杖六释义": [
      "（火）木星在狮子座。胜利、认可、赞誉、出人头地、领导权和与之而来的责任和义务。"
    ],
    "权杖七释义": [
      "（火）火星在狮子座。挑战、自我确立、自我防卫、下定决心、坚持。"
    ],
    "权杖八释义": [
      "（火）水星在射手座。迅速行动、电子信号的交流、旅行、讯息；逆位时，可能失控或延迟。"
    ],
    "权杖九释义": [
      "（火）月亮在射手座。准备、警觉、防御、经验、等待、放下过往伤痛。"
    ],
    "权杖十释义": [
      "（火）土星在射手座。压力、责任、过度工作、梦想与现实的冲突。"
    ],
    "权杖侍从释义": [
      "（宫廷）火象星座。小顽童、探索、热情、新人、对于精神发展的欲望。"
    ],
    "权杖骑士释义": [
      "（宫廷）天蝎座与射手座，占星属九宫。勇往直前、直率、大胆、鲁莽、行动派、改变、旅行。"
    ],
    "权杖王后释义": [
      "（宫廷）双鱼座与白羊座，占星属一宫。自信、热情、独立、领导力与主动性、丰收与财运。"
    ],
    "权杖国王释义": [
      "（宫廷）巨蟹座与狮子座，占星属五宫。远见、热情与自我中心、专制独裁、创造力。"
    ],
    
    "圣杯首牌释义": [
      "（水）新感情、直觉、美好的开始。"
    ],
    "圣杯二释义": [
      "（水）金星在巨蟹座。爱情、青梅竹马、志同道合、灵魂伴侣、和谐对等。"
    ],
    "圣杯三释义": [
      "（水）水星在巨蟹座。团体、丰裕、商业沟通、庆祝活动、三人行。"
    ],
    "圣杯四释义": [
      "（水）月亮在巨蟹座。冷淡、因稳固而无趣、外遇、失望、幻灭（即使伴随着丰富资源），宜三思而后行。"
    ],
    "圣杯五释义": [
      "（水）火星在天蝎座。失落、悲伤、生命中的快乐转瞬即逝、珍惜所拥有的。"
    ],
    "圣杯六释义": [
      "（水）太阳在天蝎座。怀旧、童年回忆、手足关系、朋友重聚、和解、安全、赠予。"
    ],
    "圣杯七释义": [
      "（水）金星在天蝎座。幻觉、做梦、选择、迷失自我、梦中情人、上瘾症或被欺骗；逆位时，云开雾散。"
    ],
    "圣杯八释义": [
      "（水）土星在双鱼座。懊悔、放弃、离开、牺牲、追寻（理想）。"
    ],
    "圣杯九释义": [
      "（水）木星在双鱼座。满足、物质享乐、美梦成真、庆祝活动、大型聚会、嗜酒。"
    ],
    "圣杯十释义": [
      "（水）火星在双鱼座。圆满、完美的家庭生活、人际关系中的满足；也可能代表一种理想化（不真实的氛围）。"
    ],
    "圣杯侍从释义": [
      "（宫廷）水象星座。好奇的小孩、敏感、创意、天真乐观、好幻想、馈赠、好朋友。"
    ],
    "圣杯骑士释义": [
      "（宫廷）水瓶座与双鱼座，占星属十二宫。白马王子、英勇优雅、多愁善感而充满魅力、邀请与机会。"
    ],
    "圣杯王后释义": [
      "（宫廷）双子座与巨蟹座，占星属四宫。关怀、滋养、艺术性、母性奉献、过度保护。"
    ],
    "圣杯国王释义": [
      "（宫廷）天秤座与天蝎座，占星属八宫。情感成熟、宽容、慈善家、艺术家、感官享乐、过度沉迷。"
    ],
    
    "宝剑首牌释义": [
      "（风）新思想、新挑战、理智、决心、手术或打针。"
    ],
    "宝剑二释义": [
      "（风）月亮在天秤座。难以取舍的决定、反省、沉思、直觉、逃避或抗拒。"
    ],
    "宝剑三释义": [
      "（风）土星在天秤座。悲伤、受伤、延迟。"
    ],
    "宝剑四释义": [
      "（风）木星在天秤座。暂缓执行、休养、恢复期、住院。"
